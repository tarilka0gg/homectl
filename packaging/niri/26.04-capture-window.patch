+    /// Renders a window to a PAM file (no clipboard, no screenshot event), for remote viewers.
+    pub fn capture_window(
+        &self,
+        renderer: &mut GlesRenderer,
+        output: &Output,
+        mapped: &Mapped,
+        path: String,
+    ) -> anyhow::Result<()> {
+        let _span = tracy_client::span!("Niri::capture_window");
+        let (size, pixels) = self.render_window_pixels(renderer, output, mapped, false)?;
