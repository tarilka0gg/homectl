+            let res = std::fs::File::create(&tmp).and_then(|mut f| {
+                use std::io::Write;
+                f.write_all(header.as_bytes())?;
+                f.write_all(&pixels)
+            });
+            if let Err(err) = res.and_then(|()| std::fs::rename(&tmp, &path)) {
+                warn!("error writing window capture: {err:?}");
+            }
+        });
+        Ok(())
+    }
