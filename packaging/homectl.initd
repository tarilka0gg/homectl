#!/sbin/openrc-run
# homectl daemon as an OpenRC service, supervised (restarts itself if it ever crashes).
# Settings live in /etc/conf.d/homectl:  HOMECTL_USER=...  HOMECTL_BIN=/path/to/homectl
# Public tunnel (default on, so the app can reach this machine away from home): HOMECTL_TUNNEL=quick uses a Cloudflare quick tunnel
# via the cloudflared next to the binary (or on PATH); set HOMECTL_TUNNEL=off in /etc/conf.d/homectl to disable.
description="homectl control daemon"

: "${HOMECTL_USER:=root}"
: "${HOMECTL_BIN:=/usr/local/bin/homectl}"

supervisor=supervise-daemon
command="/usr/local/bin/homectl-launch"
command_args="$HOMECTL_BIN"
command_user="$HOMECTL_USER"
output_log="/var/log/homectl.log"
error_log="/var/log/homectl.log"
respawn_delay=5
respawn_max=0

depend() {
	need net
	use tailscale
}

start_pre() {
	# an outbound-only tunnel, so the phone can reach this machine from anywhere (no port forwarding, works behind carrier NAT)
	if [ "${HOMECTL_TUNNEL:-quick}" != "off" ]; then
		export HOMECTL_TUNNEL=quick
		if [ -x "$(dirname "$HOMECTL_BIN")/cloudflared" ]; then export HOMECTL_CLOUDFLARED="$(dirname "$HOMECTL_BIN")/cloudflared"; fi
	fi
	# the daemon keeps its token and settings under $HOME
	HOME="$(getent passwd "$HOMECTL_USER" | cut -d: -f6)"
	export HOME
	PATH="$HOME/.local/bin:$PATH"
	export PATH
}
