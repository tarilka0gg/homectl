#!/sbin/openrc-run
# homectl daemon as an OpenRC service, supervised (restarts itself if it ever crashes).
# Settings live in /etc/conf.d/homectl:  HOMECTL_USER=...  HOMECTL_BIN=/path/to/homectl
# Public tunnel (default "auto", so the app can reach this machine away from home): a Cloudflare quick tunnel via the cloudflared
# next to the binary (or on PATH). auto = on, unless a server that relays to this machine is up (then it is off and starts by itself
# when the server stops answering); quick = always on; off = never. Set HOMECTL_TUNNEL in /etc/conf.d/homectl to change it.
description="homectl control daemon"

: "${HOMECTL_USER:=root}"
: "${HOMECTL_BIN:=/usr/local/bin/homectl}"

supervisor=supervise-daemon
command="/usr/local/bin/homectl-launch"
command_args="$HOMECTL_BIN"
command_user="$HOMECTL_USER"
output_log="/var/log/homectl.log"
error_log="/var/log/homectl.log"
respawn_delay=5
respawn_max=0

depend() {
	need net
	use tailscale
}

start_pre() {
	# the supervisor opens the log after dropping to the service user, so the file has to exist and belong to them
	checkpath -f -m 0640 -o "$HOMECTL_USER" /var/log/homectl.log
	# an outbound-only tunnel, so the phone can reach this machine from anywhere (no port forwarding, works behind carrier NAT)
	if [ "${HOMECTL_TUNNEL:-auto}" != "off" ]; then
		export HOMECTL_TUNNEL="${HOMECTL_TUNNEL:-auto}"
		if [ -x "$(dirname "$HOMECTL_BIN")/cloudflared" ]; then export HOMECTL_CLOUDFLARED="$(dirname "$HOMECTL_BIN")/cloudflared"; fi
	fi
	# the daemon keeps its token and settings under $HOME
	HOME="$(getent passwd "$HOMECTL_USER" | cut -d: -f6)"
	export HOME
	PATH="$HOME/.local/bin:$PATH"
	export PATH
}
